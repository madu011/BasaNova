{
  "name": "basanova",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:debug": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleDebug",
    "build:android:release": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew assembleRelease",
    "qa:content": "node scripts/content-qa.mjs"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-speech": "~14.0.7",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-clipboard": "~8.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-av": "~16.0.8",
    "expo-file-system": "~19.0.21",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2"
  }
}
